{
  "name": "text2frame-language-support",
  "displayName": "Text2Frame Language Support",
  "description": "Language support for Text2Frame visual novel scripts",
  "version": "0.1.0",
  "publisher": "yktsr",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "RPG Maker",
    "RPGツクール",
    "MV",
    "MZ",
    "Text2Frame",
    "localization",
    "translation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:text2frame",
    "onView:text2frameExplorer",
    "workspaceContains:**/text/**/*.txt",
    "workspaceContains:**/data/Map*.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "text2frame",
        "aliases": ["Text2Frame", "text2frame"],
        "extensions": [".t2f", ".text2frame"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "text2frame",
        "scopeName": "source.text2frame",
        "path": "./syntaxes/text2frame.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "text2frame.deployCurrentFile",
        "title": "Text2Frame: 現在のファイルをゲームに反映 / Deploy Current File",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.toggleDeployOnSave",
        "title": "Text2Frame: 保存時に自動でゲームに反映する / Toggle Deploy on Save"
      },
      {
        "command": "text2frame.exportCurrentFile",
        "title": "Frame2Text: ゲームからテキストへ書き出し / Export Current File from Data",
        "icon": "$(cloud-download)"
      },
      {
        "command": "text2frame.exportForTranslation",
        "title": "Text2Frame: 会話イベントのみ書き出し / Export for Translation (conversation only)"
      },
      {
        "command": "text2frame.showCompiledJson",
        "title": "Text2Frame: コンパイル結果を表示 / Show Compiled JSON",
        "icon": "$(json)"
      },
      {
        "command": "text2frame.deployAll",
        "title": "Text2Frame: すべてのテキストをゲームに反映する / Deploy All"
      },
      {
        "command": "text2frame.exportAll",
        "title": "Text2Frame: すべてのゲームイベントをテキストに書き出す / Export All"
      },
      {
        "command": "text2frame.createTranslationSet",
        "title": "Text2Frame: 翻訳セットを作成 (targetLocale) / Create Translation Set"
      },
      {
        "command": "text2frame.deployTranslationSet",
        "title": "Text2Frame: 翻訳をゲームに反映 (targetLocale) / Deploy Translation"
      },
      {
        "command": "text2frame.mergeTranslation",
        "title": "Text2Frame: 翻訳をマージ (構造を保持) / Merge Translation (overlay)"
      },
      {
        "command": "text2frame.mergeTranslation3way",
        "title": "Text2Frame: 翻訳を3wayマージ (両方残す) / Merge Translation (3-way)"
      },
      {
        "command": "text2frame.tree.refresh",
        "title": "Text2Frame: 更新 / Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.tree.deploy",
        "title": "デプロイ / Deploy",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.tree.export",
        "title": "書き出し / Export",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "text2frame",
          "title": "Text2Frame",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "text2frame": [
        {
          "id": "text2frameExplorer",
          "name": "Maps / Common Events"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "text2frame.toggleDeployOnSave",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@3"
        },
	{
          "command": "text2frame.deployCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@1"
        },
        {
          "command": "text2frame.exportCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@2"
        },
        {
          "command": "text2frame.exportForTranslation",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@2"
        },
        {
          "command": "text2frame.showCompiledJson",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@1"
        }
      ],
      "view/title": [
        {
          "command": "text2frame.tree.refresh",
          "when": "view == text2frameExplorer",
          "group": "navigation"
        },
        {
          "command": "text2frame.deployAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@1"
        },
        {
          "command": "text2frame.exportAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@2"
        },
        {
          "command": "text2frame.createTranslationSet",
          "when": "view == text2frameExplorer",
          "group": "2_translation@1"
        },
        {
          "command": "text2frame.deployTranslationSet",
          "when": "view == text2frameExplorer",
          "group": "2_translation@2"
        },
        {
          "command": "text2frame.mergeTranslation",
          "when": "view == text2frameExplorer",
          "group": "2_translation@3"
        },
        {
          "command": "text2frame.mergeTranslation3way",
          "when": "view == text2frameExplorer",
          "group": "2_translation@4"
        }
      ],
      "commandPalette": [
        { "command": "text2frame.tree.deploy", "when": "false" },
        { "command": "text2frame.tree.export", "when": "false" },
        { "command": "text2frame.tree.refresh", "when": "false" }
      ],
      "view/item/context": [
        {
          "command": "text2frame.tree.deploy",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@2"
        },
        {
          "command": "text2frame.tree.export",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Text2Frame",
      "properties": {
        "text2frame.strategy": {
          "type": "string",
          "enum": ["diff", "import", "overlay"],
          "default": "diff",
          "description": "書き出し方式。diff=最小差分マージ、import=イベントをすべて上書き、overlay=JSON構造を保持し会話だけ差し替え(翻訳マージ)。 / Deploy strategy: diff = merge minimally, import = overwrite, overlay = keep JSON structure and replace only conversation text (translation merge)."
        },
        "text2frame.normalizeAfterDeploy": {
          "type": "boolean",
          "default": false,
          "description": "テキストからゲームへ反映後、再度ゲームからテキストへ書き戻してテキストを標準形に自動整形する。/ After deploy-on-save, re-export data back to the text file to normalize it (the saved file is rewritten and the editor reloads). "
        },
        "text2frame.englishTag": {
          "type": "boolean",
          "default": true,
          "description": "テキスト書き出し時に英語タグを使う。 / Use English tags when exporting (data -> text)."
        },
        "text2frame.locale": {
          "type": "string",
          "default": "ja",
          "description": "書き出し先のサブフォルダ名を指定する。 / Locale subfolder under the text base dir for export."
        },
        "text2frame.textBaseDir": {
          "type": "string",
          "default": "text",
          "description": "テキストファイルの保存されているディレクトリを指定する。 / Base directory (relative to workspace) for text files."
        },
        "text2frame.dataDir": {
          "type": "string",
          "default": "data",
          "description": "Map###.json / CommonEvents.json が保存されているディレクトリを指定する。 / RPG Maker data directory (relative to workspace) holding Map###.json / CommonEvents.json."
        },
        "text2frame.modulePath": {
          "type": "string",
          "default": "",
          "description": "Text2Frame 本体(Text2Frame.js)のパスを明示指定。通常指定する必要はありません。空なら自動解決されます。 / Explicit path to Text2Frame.js. Empty = auto-resolve."
        },
        "text2frame.sourceLocale": {
          "type": "string",
          "default": "ja",
          "description": "翻訳元の言語(原文)。翻訳セット作成時の front matter に記録される。 / Source language for the translation set."
        },
        "text2frame.targetLocale": {
          "type": "string",
          "default": "en",
          "description": "翻訳先の言語。翻訳セット作成・デプロイの対象サブフォルダ (textBaseDir/<targetLocale>) になる。 / Target language; the text2frame.textBaseDir/<targetLocale> subfolder used by Create/Deploy Translation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-compiler",
    "compile": "tsc -p ./",
    "bundle-compiler": "node ./scripts/bundle-compiler.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yktsr/Text2Frame-MV.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/yktsr/Text2Frame-MV/issues"
  },
  "homepage": "https://github.com/yktsr/Text2Frame-MV#readme"
}

