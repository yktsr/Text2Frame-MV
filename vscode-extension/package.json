{
  "name": "text2frame-language-support",
  "displayName": "Text2Frame Language Support",
  "description": "Language support for Text2Frame visual novel scripts",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:text2frame",
    "onView:text2frameExplorer",
    "workspaceContains:**/text/**/*.txt",
    "workspaceContains:**/data/Map*.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "text2frame",
        "aliases": ["Text2Frame", "text2frame"],
        "extensions": [".t2f", ".text2frame"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "text2frame",
        "scopeName": "source.text2frame",
        "path": "./syntaxes/text2frame.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "text2frame.deployCurrentFile",
        "title": "Text2Frame: 現在のファイルをゲームに反映 / Deploy Current File",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.toggleDeployOnSave",
        "title": "Text2Frame: 保存時に自動でゲームに反映する / Toggle Deploy on Save"
      },
      {
        "command": "text2frame.exportCurrentFile",
        "title": "Frame2Text: ゲームからテキストへ書き出し / Export Current File from Data",
        "icon": "$(cloud-download)"
      },
      {
        "command": "text2frame.exportForTranslation",
        "title": "Text2Frame: 会話イベントのみ書き出し / Export for Translation (conversation only)"
      },
      {
        "command": "text2frame.showCompiledJson",
        "title": "Text2Frame: コンパイル結果を表示 / Show Compiled JSON",
        "icon": "$(json)"
      },
      {
        "command": "text2frame.deployAll",
        "title": "Text2Frame: すべてデプロイ / Deploy All"
      },
      {
        "command": "text2frame.exportAll",
        "title": "Text2Frame: すべて書き出し / Export All"
      },
      {
        "command": "text2frame.tree.refresh",
        "title": "Text2Frame: 更新 / Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.tree.deploy",
        "title": "デプロイ / Deploy",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.tree.export",
        "title": "書き出し / Export",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "text2frame",
          "title": "Text2Frame",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "text2frame": [
        {
          "id": "text2frameExplorer",
          "name": "Maps / Common Events"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "text2frame.deployCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@1"
        },
        {
          "command": "text2frame.exportCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@2"
        },
        {
          "command": "text2frame.showCompiledJson",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@1"
        },
        {
          "command": "text2frame.exportForTranslation",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@2"
        },
        {
          "command": "text2frame.toggleDeployOnSave",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@3"
        }
      ],
      "view/title": [
        {
          "command": "text2frame.tree.refresh",
          "when": "view == text2frameExplorer",
          "group": "navigation"
        },
        {
          "command": "text2frame.deployAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@1"
        },
        {
          "command": "text2frame.exportAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@2"
        }
      ],
      "commandPalette": [
        { "command": "text2frame.tree.deploy", "when": "false" },
        { "command": "text2frame.tree.export", "when": "false" },
        { "command": "text2frame.tree.refresh", "when": "false" }
      ],
      "view/item/context": [
        {
          "command": "text2frame.tree.deploy",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@2"
        },
        {
          "command": "text2frame.tree.export",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Text2Frame",
      "properties": {
        "text2frame.strategy": {
          "type": "string",
          "enum": ["diff", "import"],
          "default": "diff",
          "description": "デプロイ方式。diff=最小マージ、import=イベントを上書き。 / Deploy strategy: diff = merge minimally, import = overwrite the event."
        },
        "text2frame.normalizeAfterDeploy": {
          "type": "boolean",
          "default": false,
          "description": "保存時デプロイの後、データからテキストへ書き戻してテキストを正準形に整形します(保存ファイルが書き換わり、エディタが再読込されます)。外部変更の取り込みではありません。 / After deploy-on-save, re-export data back to the text file to normalize it (the saved file is rewritten and the editor reloads). This does not pull external changes."
        },
        "text2frame.modulePath": {
          "type": "string",
          "default": "",
          "description": "Text2Frame 本体(Text2Frame.js)のパスを明示指定。空なら自動解決(同梱lib→モノレポ兄弟→ワークスペース)。 / Explicit path to Text2Frame.js. Empty = auto-resolve (bundled lib, monorepo sibling, or workspace)."
        },
        "text2frame.englishTag": {
          "type": "boolean",
          "default": true,
          "description": "書き出し(データ→テキスト)時に英語タグを使う。 / Use English tags when exporting (data -> text)."
        },
        "text2frame.locale": {
          "type": "string",
          "default": "ja",
          "description": "書き出し先のロケールサブフォルダ(テキスト基準ディレクトリ配下)。 / Locale subfolder under the text base dir for export."
        },
        "text2frame.textBaseDir": {
          "type": "string",
          "default": "text",
          "description": "テキストファイルの基準ディレクトリ(ワークスペース相対)。 / Base directory (relative to workspace) for text files."
        },
        "text2frame.dataDir": {
          "type": "string",
          "default": "data",
          "description": "Map###.json / CommonEvents.json を置くデータフォルダ(ワークスペース相対)。 / RPG Maker data directory (relative to workspace) holding Map###.json / CommonEvents.json."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-compiler",
    "compile": "tsc -p ./",
    "bundle-compiler": "node ./scripts/bundle-compiler.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yktsr/Text2Frame-MV.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/yktsr/Text2Frame-MV/issues"
  },
  "homepage": "https://github.com/yktsr/Text2Frame-MV#readme"
}

