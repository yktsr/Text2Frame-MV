{
  "name": "text2frame-language-support",
  "displayName": "Text2Frame Language Support",
  "description": "Language support for Text2Frame visual novel scripts",
  "version": "0.1.0",
  "publisher": "yktsr",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "RPG Maker",
    "RPGツクール",
    "MV",
    "MZ",
    "Text2Frame",
    "localization",
    "translation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:text2frame",
    "onView:text2frameCommands",
    "onView:text2frameExplorer",
    "workspaceContains:**/text/**/*.txt",
    "workspaceContains:**/data/Map*.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "text2frame",
        "aliases": ["Text2Frame", "text2frame"],
        "extensions": [".t2f", ".text2frame"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "text2frame",
        "scopeName": "source.text2frame",
        "path": "./syntaxes/text2frame.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "text2frame.deployCurrentFile",
        "title": "Text2Frame: 現在のファイルをゲームに反映 / Deploy Current File",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.toggleDeployOnSave",
        "title": "Text2Frame: 保存時に自動でゲームに反映する / Toggle Deploy on Save"
      },
      {
        "command": "text2frame.exportCurrentFile",
        "title": "Frame2Text: ゲームからテキストへ書き出し / Export Current File from Data",
        "icon": "$(cloud-download)"
      },
      {
        "command": "text2frame.exportConversationOnly",
        "title": "Text2Frame: 会話のみ書き出し / Export Conversation Only"
      },
      {
        "command": "text2frame.showCompiledJson",
        "title": "Text2Frame: コンパイル結果を表示 / Show Compiled JSON",
        "icon": "$(json)"
      },
      {
        "command": "text2frame.deployAll",
        "title": "Text2Frame: すべてのテキストをゲームに反映する / Deploy All"
      },
      {
        "command": "text2frame.exportAll",
        "title": "Text2Frame: すべてのゲームイベントをテキストに書き出す / Export All"
      },
      {
        "command": "text2frame.seedLocale",
        "title": "Text2Frame: ロケールを複製して着手 (sourceLocale→targetLocale) / Seed Locale"
      },
      {
        "command": "text2frame.deployLocale",
        "title": "Text2Frame: ロケールをデプロイ (targetLocale, 既定 merge) / Deploy Locale"
      },
      {
        "command": "text2frame.tree.refresh",
        "title": "Text2Frame: 更新 / Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.tree.deploy",
        "title": "デプロイ / Deploy",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.tree.export",
        "title": "書き出し / Export",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "text2frame",
          "title": "Text2Frame",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "text2frame": [
        {
          "id": "text2frameCommands",
          "name": "操作 / Commands"
        },
        {
          "id": "text2frameExplorer",
          "name": "Maps / Common Events"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "text2frame.toggleDeployOnSave",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@3"
        },
	{
          "command": "text2frame.deployCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@1"
        },
        {
          "command": "text2frame.exportCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@2"
        },
        {
          "command": "text2frame.exportConversationOnly",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@2"
        },
        {
          "command": "text2frame.showCompiledJson",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "1_text2frame@1"
        }
      ],
      "view/title": [
        {
          "command": "text2frame.tree.refresh",
          "when": "view == text2frameExplorer",
          "group": "navigation"
        },
        {
          "command": "text2frame.deployAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@1"
        },
        {
          "command": "text2frame.exportAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@2"
        },
        {
          "command": "text2frame.seedLocale",
          "when": "view == text2frameExplorer",
          "group": "2_locale@1"
        },
        {
          "command": "text2frame.deployLocale",
          "when": "view == text2frameExplorer",
          "group": "2_locale@2"
        }
      ],
      "commandPalette": [
        { "command": "text2frame.tree.deploy", "when": "false" },
        { "command": "text2frame.tree.export", "when": "false" },
        { "command": "text2frame.tree.refresh", "when": "false" }
      ],
      "view/item/context": [
        {
          "command": "text2frame.tree.deploy",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@2"
        },
        {
          "command": "text2frame.tree.export",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Text2Frame",
      "properties": {
        "text2frame.strategy": {
          "type": "string",
          "enum": ["merge", "overwrite"],
          "default": "merge",
          "description": "反映方式。merge=JSON構造(UIで足した移動・分岐・スイッチ等)を保ちつつテキストを賢く反映(祖先があれば3wayマージ、無ければ会話のみ差し替え、空イベントは新規反映)。overwrite=テキストを正としてすべて上書き。旧値(diff/import/overlay/merge3/sync)も内部で正規化され受理されます。 / Deploy strategy: merge = keep JSON structure and smart-apply text (3-way when an ancestor exists, otherwise overlay conversation; empty events populated wholesale). overwrite = replace everything from text. Legacy values (diff/import/overlay/merge3/sync) are still accepted and normalized."
        },
        "text2frame.writeBackAfterMerge": {
          "type": "string",
          "enum": ["off", "onConflict", "always"],
          "default": "onConflict",
          "enumDescriptions": [
            "書き戻さない / never write back",
            "3-wayで衝突(両方残し)が出た時だけ、マージ結果をテキストへ書き戻す(既定) / write back only when the merge kept conflicts",
            "デプロイ成功のたびにマージ結果をテキストへ書き戻す(テキストが常にJSONを反映) / write back after every successful deploy"
          ],
          "description": "merge 反映後にマージ結果をテキストへ自動で書き戻すか。書き戻すと 3-way の共通祖先(BASE)も更新され、次回はクリーンな 3-way になります。衝突は「テキストの変更 / ゲームの変更」の目印コメントで両方残るので、テキスト側で解決できます(タグ記号は使わないので文法警告は出ません)。 / Whether to write the merged result back into the text after a merge deploy (also refreshes the 3-way BASE). Conflicts are kept as both sides with plain comment markers so you can resolve them in text."
        },
        "text2frame.englishTag": {
          "type": "boolean",
          "default": true,
          "description": "テキスト書き出し時に英語タグを使う。 / Use English tags when exporting (data -> text)."
        },
        "text2frame.locale": {
          "type": "string",
          "default": "ja",
          "description": "書き出し先のサブフォルダ名を指定する。 / Locale subfolder under the text base dir for export."
        },
        "text2frame.textBaseDir": {
          "type": "string",
          "default": "text",
          "description": "テキストファイルの保存されているディレクトリを指定する。 / Base directory (relative to workspace) for text files."
        },
        "text2frame.dataDir": {
          "type": "string",
          "default": "data",
          "description": "Map###.json / CommonEvents.json が保存されているディレクトリを指定する。 / RPG Maker data directory (relative to workspace) holding Map###.json / CommonEvents.json."
        },
        "text2frame.modulePath": {
          "type": "string",
          "default": "",
          "description": "Text2Frame 本体(Text2Frame.js)のパスを明示指定。通常指定する必要はありません。空なら自動解決されます。 / Explicit path to Text2Frame.js. Empty = auto-resolve."
        },
        "text2frame.sourceLocale": {
          "type": "string",
          "default": "ja",
          "description": "複製元のロケール(原文)。「ロケールを複製して着手 (Seed Locale)」のときだけ使われ、front matter に記録されます。 / Source locale to copy from; used only by Seed Locale."
        },
        "text2frame.targetLocale": {
          "type": "string",
          "default": "en",
          "description": "作業ロケール。Seed Locale / Deploy Locale の対象サブフォルダ (textBaseDir/<targetLocale>) になります。 / Working locale; the textBaseDir/<targetLocale> subfolder used by Seed/Deploy Locale."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-compiler",
    "compile": "tsc -p ./",
    "bundle-compiler": "node ./scripts/bundle-compiler.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yktsr/Text2Frame-MV.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/yktsr/Text2Frame-MV/issues"
  },
  "homepage": "https://github.com/yktsr/Text2Frame-MV#readme"
}

