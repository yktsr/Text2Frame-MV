{
  "name": "text2frame-language-support",
  "displayName": "Text2Frame Language Support",
  "description": "Language support for Text2Frame visual novel scripts",
  "version": "0.1.2",
  "publisher": "yktsr",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "RPG Maker",
    "RPGツクール",
    "MV",
    "MZ",
    "Text2Frame",
    "localization",
    "translation"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:text2frame",
    "onView:text2frameCommands",
    "onView:text2frameExplorer",
    "onView:text2frameDatabase",
    "onView:text2frame.liveValues",
    "onWebviewPanel:text2frameLive",
    "onDebugResolve:text2frame",
    "onDebugDynamicConfigurations:text2frame",
    "workspaceContains:**/text/**/*.txt",
    "workspaceContains:**/data/Map*.json"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.readonlyInclude": {
        "**/.t2f-base/**": true,
        "**/.t2f-history/**": true
      }
    },
    "languages": [
      {
        "id": "text2frame",
        "aliases": ["Text2Frame", "text2frame"],
        "extensions": [".t2f", ".text2frame"],
        "configuration": "./language-configuration.json"
      }
    ],
    "debuggers": [
      {
        "type": "text2frame",
        "label": "Text2Frame テストプレイ",
        "languages": ["text2frame"],
        "configurationAttributes": {
          "launch": { "properties": {} }
        },
        "initialConfigurations": [
          { "type": "text2frame", "request": "launch", "name": "Text2Frame テストプレイ" }
        ],
        "configurationSnippets": [
          {
            "label": "Text2Frame: テストプレイ",
            "description": "テストプレイを、ブレークポイントで止めて調べる",
            "body": { "type": "text2frame", "request": "launch", "name": "Text2Frame テストプレイ" }
          }
        ]
      }
    ],
    "breakpoints": [
      { "language": "text2frame" }
    ],
    "grammars": [
      {
        "language": "text2frame",
        "scopeName": "source.text2frame",
        "path": "./syntaxes/text2frame.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "text2frame.deployCurrentFile",
        "title": "Text2Frame: ゲームに反映(このファイル) / Apply to game (this file)",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.toggleDeployOnSave",
        "title": "Text2Frame: 保存時に自動でゲームに反映する / Toggle apply-on-save"
      },
      {
        "command": "text2frame.exportCurrentFile",
        "title": "Text2Frame: ゲームから取り出す(このファイル) / Pull from game (this file)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "text2frame.exportConversationOnly",
        "title": "Text2Frame: 会話のみ書き出し / Pull conversation only"
      },
      {
        "command": "text2frame.showPreview",
        "title": "Text2Frame: プレビューを開く / Open preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "text2frame.testPlay",
        "title": "Text2Frame: テストプレイ(VS Code の中で) / Test play inside VS Code",
        "icon": "$(play)"
      },
      {
        "command": "text2frame.testPlayExternal",
        "title": "Text2Frame: テストプレイ(外のブラウザで) / Test play in an external browser",
        "icon": "$(link-external)"
      },
      {
        "command": "text2frame.stopTestPlay",
        "title": "Text2Frame: テストプレイのサーバーを止める / Stop the test play server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "text2frame.showLiveValues",
        "title": "Text2Frame: スイッチと変数を見る(テストプレイ中) / Show switches & variables while test playing",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "text2frame.openLiveValuesTab",
        "title": "Text2Frame: デバッグメニューを表示 / Show the debug menu",
        "icon": "$(window)"
      },
      {
        "command": "text2frame.checkProject",
        "title": "Text2Frame: プロジェクト全体を検査 / Check the whole project",
        "icon": "$(checklist)"
      },
      {
        "command": "text2frame.pickFace",
        "title": "Text2Frame: 顔画像を選ぶ / Pick a face",
        "icon": "$(account)"
      },
      {
        "command": "text2frame.pickAudio",
        "title": "Text2Frame: 音を選ぶ / Pick a sound",
        "icon": "$(unmute)"
      },
      {
        "command": "text2frame.snippet.insert",
        "title": "Text2Frame: スニペットを入れる / Insert a snippet"
      },
      {
        "command": "text2frame.snippet.fromSelection",
        "title": "Text2Frame: 選んだ部分をスニペットにする / Make a snippet from the selection"
      },
      {
        "command": "text2frame.snippet.edit",
        "title": "Text2Frame: スニペットを編集する / Edit snippets"
      },
      {
        "command": "text2frame.standAtEvent",
        "title": "Text2Frame: イベントの前に立つ / Stand in front of the event",
        "icon": "$(person)"
      },
      {
        "command": "text2frame.runThisPage",
        "title": "Text2Frame: このページをすぐ実行 / Run this page now",
        "icon": "$(play-circle)"
      },
      {
        "command": "text2frame.debug",
        "title": "Text2Frame: デバッグを始める(ブレークポイント) / Start debugging",
        "icon": "$(debug-alt)"
      },
      {
        "command": "text2frame.tryEvent",
        "title": "Text2Frame: このイベントから試す / Try this event"
      },
      {
        "command": "text2frame.fix.pickAgain",
        "title": "Text2Frame: 候補から選び直す / Pick again"
      },
      {
        "command": "text2frame.review.accept",
        "title": "Text2Frame: 反映する(差分の確認) / Apply (after review)",
        "icon": "$(check)"
      },
      {
        "command": "text2frame.review.cancel",
        "title": "Text2Frame: やめる(差分の確認) / Cancel (review)",
        "icon": "$(close)"
      },
      {
        "command": "text2frame.showCompiledJson",
        "title": "Text2Frame: コンパイル結果を表示 / Show compiled JSON",
        "icon": "$(json)"
      },
      {
        "command": "text2frame.deployAll",
        "title": "Text2Frame: ゲームに反映(すべて) / Apply to game (all)"
      },
      {
        "command": "text2frame.exportAll",
        "title": "Text2Frame: ゲームから取り出す(すべて) / Pull from game (all)"
      },
      {
        "command": "text2frame.repullOverwrite",
        "title": "Text2Frame: 全部取り直す(上書き) / Re-pull (overwrite)"
      },
      {
        "command": "text2frame.db.insert",
        "title": "番号を挿入 / Insert id"
      },
      {
        "command": "text2frame.db.findUsages",
        "title": "使っている箇所を探す / Find usages",
        "icon": "$(search)"
      },
      {
        "command": "text2frame.db.showUsages",
        "title": "使っている箇所を前後の行つきで一覧 / List usages with context"
      },
      {
        "command": "text2frame.db.refresh",
        "title": "Text2Frame: データベースを読み直す / Reload database",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.tree.refresh",
        "title": "Text2Frame: 更新 / Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.tree.deploy",
        "title": "デプロイ / Deploy",
        "icon": "$(rocket)"
      },
      {
        "command": "text2frame.tree.export",
        "title": "書き出し / Export",
        "icon": "$(cloud-download)"
      },
      {
        "command": "text2frame.tree.try",
        "title": "イベントの前に立つ / Stand in front of the event",
        "icon": "$(person)"
      },
      {
        "command": "text2frame.tree.tryRun",
        "title": "このページをすぐ実行 / Run this page now",
        "icon": "$(play)"
      },
      {
        "command": "text2frame.tree.tryCommon",
        "title": "すぐ実行 / Run now",
        "icon": "$(play)"
      },
      {
        "command": "text2frame.tree.links",
        "title": "つながりを見る / Show links",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "text2frame.showLinks",
        "title": "Text2Frame: イベントのつながりを見る / Show event links",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "text2frame.mapLinks.show",
        "title": "マップのつながりを見る / Show map links"
      },
      {
        "command": "text2frame.mapLinks.refresh",
        "title": "Text2Frame: つながりを更新 / Refresh links",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.mapLinks.open",
        "title": "つながりの行を開く / Open the link"
      },
      {
        "command": "text2frame.tree.mapLinks",
        "title": "マップのつながりを見る / Show map links",
        "icon": "$(arrow-both)"
      },
      {
        "command": "text2frame.showMapGraph",
        "title": "Text2Frame: マップのつながりを図で見る / Show the map graph",
        "icon": "$(graph)"
      },
      {
        "command": "text2frame.tree.mapGraph",
        "title": "マップのつながりを図で見る / Show the map graph",
        "icon": "$(graph)"
      },
      {
        "command": "text2frame.history.show",
        "title": "Text2Frame: 履歴(前の状態に戻す) / Show history",
        "icon": "$(history)"
      },
      {
        "command": "text2frame.history.refresh",
        "title": "更新 / Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "text2frame.history.openFolder",
        "title": "控えのフォルダを開く / Open the history folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "text2frame.history.diff",
        "title": "差分を見る / Show changes",
        "icon": "$(diff)"
      },
      {
        "command": "text2frame.history.restore",
        "title": "この操作の前に戻す / Go back to before this",
        "icon": "$(discard)"
      },
      {
        "command": "text2frame.history.restoreFile",
        "title": "このファイルだけ戻す / Go back for this file only",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "text2frame",
          "title": "Text2Frame",
          "icon": "$(book)"
        }
      ],
      "panel": [
        {
          "id": "text2frameLive",
          "title": "Text2Frame デバッグプレイ",
          "icon": "$(play)"
        }
      ]
    },
    "views": {
      "text2frame": [
        {
          "id": "text2frameCommands",
          "name": "操作 / Commands"
        },
        {
          "id": "text2frameExplorer",
          "name": "Maps / Common Events"
        },
        {
          "id": "text2frameMapLinks",
          "name": "マップのつながり / Map Links",
          "visibility": "collapsed"
        },
        {
          "id": "text2frameHistory",
          "name": "履歴 / History",
          "visibility": "collapsed"
        },
        {
          "id": "text2frameDatabase",
          "name": "データベース / Database"
        }
      ],
      "text2frameLive": [
        {
          "type": "webview",
          "id": "text2frame.liveValues",
          "name": "スイッチと変数 / Switches & Variables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "text2frameDatabase",
        "contents": "ツクールのプロジェクト(data/System.json)が見つかりません。\nプロジェクトのテキストを開くと、そのデータベースがここに出ます。\nNo RPG Maker project (data/System.json) was found. Open a text of the project to list its database here."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "text2frame.snippet.fromSelection",
          "when": "editorLangId == text2frame && editorHasSelection",
          "group": "9_text2frame@1"
        },
        {
          "command": "text2frame.snippet.insert",
          "when": "editorLangId == text2frame",
          "group": "9_text2frame@2"
        },
        {
          "command": "text2frame.pickFace",
          "when": "editorLangId == text2frame",
          "group": "9_text2frame@3"
        },
        {
          "command": "text2frame.pickAudio",
          "when": "editorLangId == text2frame",
          "group": "9_text2frame@4"
        }
      ],
      "editor/title": [
        {
          "command": "text2frame.review.accept",
          "when": "text2frame.reviewPending && (isInDiffEditor || activeEditor == multiDiffEditor)",
          "group": "navigation@-2"
        },
        {
          "command": "text2frame.review.cancel",
          "when": "text2frame.reviewPending && (isInDiffEditor || activeEditor == multiDiffEditor)",
          "group": "navigation@-1"
        },
        {
          "command": "text2frame.deployCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@1"
        },
        {
          "command": "text2frame.exportCurrentFile",
          "when": "resourceLangId == text2frame || resourceExtname == .txt",
          "group": "navigation@2"
        },
        {
          "command": "text2frame.showPreview",
          "when": "resourceLangId == text2frame",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "text2frame.openLiveValuesTab",
          "when": "view == text2frame.liveValues",
          "group": "navigation"
        },
        {
          "command": "text2frame.tree.refresh",
          "when": "view == text2frameExplorer",
          "group": "navigation"
        },
        {
          "command": "text2frame.mapLinks.refresh",
          "when": "view == text2frameMapLinks",
          "group": "navigation"
        },
        {
          "command": "text2frame.history.refresh",
          "when": "view == text2frameHistory",
          "group": "navigation@1"
        },
        {
          "command": "text2frame.history.openFolder",
          "when": "view == text2frameHistory",
          "group": "navigation@2"
        },
        {
          "command": "text2frame.db.refresh",
          "when": "view == text2frameDatabase",
          "group": "navigation"
        },
        {
          "command": "text2frame.deployAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@1"
        },
        {
          "command": "text2frame.exportAll",
          "when": "view == text2frameExplorer",
          "group": "1_batch@2"
        },
        {
          "command": "text2frame.repullOverwrite",
          "when": "view == text2frameExplorer",
          "group": "2_advanced@1"
        }
      ],
      "commandPalette": [
        { "command": "text2frame.fix.pickAgain", "when": "false" },
        { "command": "text2frame.tryEvent", "when": "false" },
        { "command": "text2frame.review.accept", "when": "text2frame.reviewPending" },
        { "command": "text2frame.review.cancel", "when": "text2frame.reviewPending" },
        { "command": "text2frame.tree.deploy", "when": "false" },
        { "command": "text2frame.tree.export", "when": "false" },
        { "command": "text2frame.tree.refresh", "when": "false" },
        { "command": "text2frame.tree.try", "when": "false" },
        { "command": "text2frame.tree.tryRun", "when": "false" },
        { "command": "text2frame.tree.tryCommon", "when": "false" },
        { "command": "text2frame.tree.links", "when": "false" },
        { "command": "text2frame.tree.mapLinks", "when": "false" },
        { "command": "text2frame.tree.mapGraph", "when": "false" },
        { "command": "text2frame.history.refresh", "when": "false" },
        { "command": "text2frame.history.diff", "when": "false" },
        { "command": "text2frame.history.restore", "when": "false" },
        { "command": "text2frame.history.restoreFile", "when": "false" },
        { "command": "text2frame.mapLinks.show", "when": "false" },
        { "command": "text2frame.mapLinks.open", "when": "false" },
        { "command": "text2frame.db.insert", "when": "false" },
        { "command": "text2frame.db.findUsages", "when": "false" },
        { "command": "text2frame.db.showUsages", "when": "false" }
      ],
      "view/item/context": [
        {
          "command": "text2frame.db.findUsages",
          "when": "view == text2frameDatabase && viewItem == text2frame.dbEntry",
          "group": "inline@1"
        },
        {
          "command": "text2frame.db.findUsages",
          "when": "view == text2frameDatabase && viewItem == text2frame.dbEntry",
          "group": "1_find@1"
        },
        {
          "command": "text2frame.db.showUsages",
          "when": "view == text2frameDatabase && viewItem == text2frame.dbEntry",
          "group": "1_find@2"
        },
        {
          "command": "text2frame.db.insert",
          "when": "view == text2frameDatabase && viewItem == text2frame.dbEntry",
          "group": "2_insert@1"
        },
        {
          "command": "text2frame.tree.deploy",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@2"
        },
        {
          "command": "text2frame.tree.export",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common)",
          "group": "inline@1"
        },
        {
          "command": "text2frame.tree.try",
          "when": "view == text2frameExplorer && (viewItem == text2frame.event || viewItem == text2frame.page)",
          "group": "3_try@1"
        },
        {
          "command": "text2frame.tree.tryRun",
          "when": "view == text2frameExplorer && viewItem == text2frame.page",
          "group": "3_try@2"
        },
        {
          "command": "text2frame.tree.tryCommon",
          "when": "view == text2frameExplorer && viewItem == text2frame.common",
          "group": "3_try@1"
        },
        {
          "command": "text2frame.tree.links",
          "when": "view == text2frameExplorer && (viewItem == text2frame.page || viewItem == text2frame.common || viewItem == text2frame.event || viewItem == text2frame.map)",
          "group": "4_links@1"
        },
        {
          "command": "text2frame.tree.mapLinks",
          "when": "view == text2frameExplorer && (viewItem == text2frame.map || viewItem == text2frame.here)",
          "group": "4_links@2"
        },
        {
          "command": "text2frame.tree.mapGraph",
          "when": "view == text2frameExplorer && (viewItem == text2frame.map || viewItem == text2frame.here)",
          "group": "4_links@3"
        },
        {
          "command": "text2frame.history.restore",
          "when": "view == text2frameHistory && viewItem == text2frame.history.entry",
          "group": "1_restore@1"
        },
        {
          "command": "text2frame.history.diff",
          "when": "view == text2frameHistory && viewItem == text2frame.history.entry",
          "group": "2_diff@1"
        },
        {
          "command": "text2frame.history.restoreFile",
          "when": "view == text2frameHistory && viewItem == text2frame.history.file",
          "group": "1_restore@1"
        },
        {
          "command": "text2frame.history.diff",
          "when": "view == text2frameHistory && viewItem == text2frame.history.file",
          "group": "2_diff@1"
        }
      ]
    },
    "configuration": {
      "title": "Text2Frame",
      "properties": {
        "text2frame.strategy": {
          "type": "string",
          "enum": ["merge", "overwrite"],
          "default": "merge",
          "enumDescriptions": [
            "安全に統合(ゲーム側の編集を勝手に消さない・既定) / safe (keeps edits made in the game)",
            "テキストで全部上書き(ゲーム側の編集は消えます) / overwrite everything from text"
          ],
          "description": "ゲームへの反映のしかた。通常は既定のままで大丈夫です。 / How text is applied to the game. The default is fine for most users."
        },
        "text2frame.messageCheck": {
          "type": "string",
          "enum": ["auto", "on", "off"],
          "default": "auto",
          "enumDescriptions": [
            "自動(自動で改行するプラグインが有効なら調べない・既定) / auto (off when a word-wrap plugin is enabled)",
            "いつも調べる / always",
            "調べない / never"
          ],
          "description": "メッセージがウィンドウの幅からはみ出す行を知らせる。 / Warn about message lines wider than the window."
        },
        "text2frame.history.keep": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "反映・取り出しの前の中身を、何回ぶん控えておくか(ゲームのフォルダの .t2f-history)。0 にすると控えない。 / How many apply/pull operations to keep in the history (.t2f-history in the game folder). 0 turns it off."
        },
        "text2frame.tryEvent.clearPlayerTransparency": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "「このページをすぐ実行」で試すとき、プレイヤーの透明化を解除してから始める。オフにすると、透明かどうかはゲームのそのときのまま(「イベントの前に立つ」はいつも解除する)。 / Make the player visible before running a page from the editor. When off, the player stays as the game has it (standing in front of an event always makes it visible)."
        },
        "text2frame.messageLineLength": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "顔の無いメッセージの1行に入る文字数(全角で数える)。0 なら System.json から自動で決める。 / Characters (full width) per line of a message without a face. 0 works it out from System.json."
        },
        "text2frame.reviewBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "ボタンで「ゲームに反映」「ゲームから取り出す」をするとき、変わる所を差分の画面で見せ、「反映する」「書き込む」を押してから書き込む。保存時の自動反映は確かめずに書き込みます。 / Show what will change in a diff and write only after you accept, when applying or pulling from a button. Apply-on-save writes without asking."
        },
        "text2frame.writeBackAfterMerge": {
          "type": "string",
          "enum": ["off", "onConflict", "always"],
          "default": "onConflict",
          "enumDescriptions": [
            "書き戻さない / never",
            "競合したときだけ書き戻す(既定) / only when there is a conflict to resolve",
            "反映のたびに書き戻す / after every apply"
          ],
          "description": "テキストとゲームで同じ所を別々に変更して競合したとき、結果をテキストに書き戻して確認・解決できるようにするか。 / When the same spot was changed both in text and in the game, whether to write the result back into the text so you can review and resolve it."
        },
        "text2frame.englishTag": {
          "type": "boolean",
          "default": true,
          "description": "テキスト書き出し時に英語タグを使う。 / Use English tags when exporting (data -> text)."
        },
        "text2frame.omitDefaultTags": {
          "type": "boolean",
          "default": true,
          "description": "テキスト書き出し時、既定値と同じ顔・背景・位置のタグを書かない(3つとも既定ならタグ行ごと省く)。省いた所は反映時に既定値が補われるため、ゲームの見た目は変わりません。 / When exporting (data -> text), omit face/background/position tags that match the defaults (the whole tag line disappears when all three do). Apply fills the defaults back in, so the game is unchanged."
        },
        "text2frame.testPlayPage": {
          "type": "string",
          "default": "",
          "description": "テストプレイで開くページ(ゲームのフォルダからの相対パス)。空なら index.html。 / The page to open for test play, relative to the game folder. Empty means index.html."
        },
        "text2frame.openRunningText": {
          "type": "boolean",
          "default": false,
          "description": "テストプレイ中、実行しているイベントのテキストを自動で開く(ゲームの画面から入力は移さない)。「スイッチと変数」のパネルでも切り替えられます。 / While test playing, open the text of the running event automatically (keeping the input on the game). Also switchable from the Switches & Variables panel."
        },
        "text2frame.showDatabaseNames": {
          "type": "boolean",
          "default": true,
          "description": "スイッチ・変数・マップなどの番号の横に、ツクールのデータベースの名前を薄く表示する(ファイルには書き込みません)。 / Show RPG Maker database names next to switch / variable / map ids (display only; nothing is written to the file)."
        },
        "text2frame.usageContextLines": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 20,
          "description": "データベースの一覧でスイッチ・変数を押したときの「使っている箇所」に、前後何行ずつ出すか。 / How many lines to show before and after each usage when a switch or variable is clicked in the database list."
        },
        "text2frame.textBaseDir": {
          "type": "string",
          "default": "text",
          "description": "テキストファイルの保存されているディレクトリを指定する。「ゲームに反映」「ゲームから取り出す」はこのディレクトリを対象にします。 / Base directory (relative to workspace) for text files. Apply / Pull operate on this directory."
        },
        "text2frame.dataDir": {
          "type": "string",
          "default": "data",
          "description": "Map###.json / CommonEvents.json が保存されているディレクトリを指定する。 / RPG Maker data directory (relative to workspace) holding Map###.json / CommonEvents.json."
        },
        "text2frame.modulePath": {
          "type": "string",
          "default": "",
          "description": "Text2Frame 本体(Text2Frame.js)のパスを明示指定。通常指定する必要はありません。空なら自動解決されます。 / Explicit path to Text2Frame.js. Empty = auto-resolve."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-compiler",
    "compile": "tsc -p ./",
    "bundle-compiler": "node ./scripts/bundle-compiler.js",
    "update-grammar": "node ./scripts/update-grammar.js",
    "update-tag-help": "node ./scripts/update-tag-help.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ../node_modules/mocha/bin/mocha.js test",
    "lint": "eslint src test --ext ts,js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
