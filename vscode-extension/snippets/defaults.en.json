{
  "Choices (2)": {
    "prefix": [
      "choices2",
      "選択肢2"
    ],
    "body": [
      "<ShowChoices: Window, Right, 1, 2>",
      "<When: ${1:Yes}>",
      "$2",
      "<When: ${3:No}>",
      "$4",
      "<End>"
    ],
    "description": "Show two choices and write what each one does"
  },
  "Choices (3)": {
    "prefix": [
      "choices3",
      "選択肢3"
    ],
    "body": [
      "<ShowChoices: Window, Right, 1, 3>",
      "<When: ${1:Choice 1}>",
      "$2",
      "<When: ${3:Choice 2}>",
      "$4",
      "<When: ${5:Choice 3}>",
      "$6",
      "<End>"
    ],
    "description": "Show three choices and write what each one does"
  },
  "If (switch)": {
    "prefix": [
      "ifswitch",
      "条件分岐スイッチ"
    ],
    "body": [
      "<If: Switches[${1:1}], ${2|ON,OFF|}>",
      "$3",
      "<Else>",
      "$4",
      "<End>"
    ],
    "description": "When a switch is ON (or OFF), and otherwise"
  },
  "If (variable)": {
    "prefix": [
      "ifvariable",
      "条件分岐変数"
    ],
    "body": [
      "<If: Variables[${1:1}], ${2|>=,==,<=,>,<,!=|}, ${3:0}>",
      "$4",
      "<Else>",
      "$5",
      "<End>"
    ],
    "description": "When a variable meets the condition, and otherwise"
  },
  "Line with a face": {
    "prefix": [
      "face",
      "顔"
    ],
    "body": [
      "<Face: ${1:Actor1}(${2:0})>",
      "${3:Line}"
    ],
    "description": "A line of dialogue with a face graphic"
  },
  "Control Switches": {
    "prefix": [
      "switch",
      "スイッチ"
    ],
    "body": [
      "<Switch: ${1:1}, ${2|ON,OFF|}>"
    ],
    "description": "Turn a switch ON / OFF"
  },
  "Control Variables": {
    "prefix": [
      "set",
      "変数"
    ],
    "body": [
      "<Set: ${1:1}, ${2:0}>"
    ],
    "description": "Put a value into a variable"
  },
  "Transfer Player": {
    "prefix": [
      "transfer",
      "場所移動"
    ],
    "body": [
      "<TransferPlayer: Direct[${1:1}][${2:0}][${3:0}], Retain, Black>"
    ],
    "description": "Move to another map (map id, X, Y)"
  },
  "Play BGM": {
    "prefix": [
      "bgm",
      "BGM"
    ],
    "body": [
      "<PlayBGM: ${1:Theme1}, 90, 100, 0>"
    ],
    "description": "Play BGM (name, volume, pitch, pan)"
  },
  "Wait": {
    "prefix": [
      "wait",
      "ウェイト"
    ],
    "body": [
      "<Wait: ${1:60}>"
    ],
    "description": "Wait for the given frames (60 is about a second)"
  },
  "Loop": {
    "prefix": [
      "loop",
      "ループ"
    ],
    "body": [
      "<Loop>",
      "$1",
      "<BreakLoop>",
      "<RepeatAbove>"
    ],
    "description": "Loop (leave it with <BreakLoop>)"
  }
}
