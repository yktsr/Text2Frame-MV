# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/
# ...but our top-level bin/ holds CLI wrapper sources (npm bin), not build output.
!/bin/
!/bin/*.js

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk
*.bak

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
node_modules

# VSCode extension (vscode-extension/) build outputs
vscode-extension/out/
vscode-extension/lib/
*.vsix

# 公開用のバンドル。rollup の生成物で、publish のたびに prepack が作り直す。
# files には残してあるので tarball には入る(コミットしないだけ)。
Text2Frame.cjs.js
Text2Frame.es.mjs
Text2Frame.umd.js

# Packaging outputs. dist/ is rollup's target; release/ is what tools/pack-all.sh collects.
# 公開される cjs/es/umd バンドルはリポジトリ直下のコミット済みコピーのほう (RELEASE.md B-1)。
dist/
release/

# 3-way merge base snapshots (Text2Frame)
.t2f-base/

sample*
