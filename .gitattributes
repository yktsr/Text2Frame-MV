# Normalize line endings: text sources are stored and checked out with LF.
# (Binary assets under sample/ are untracked and unaffected.)
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
# CRLF の取り込みを試す検体。行末をそのまま保つ(正規化すると検査の意味が消える)。
test/crlf.txt -text
*.yml  text eol=lf
*.yaml text eol=lf
