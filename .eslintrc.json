{
    "env": {
        "browser": true,
        "commonjs": true,
        "es6": true
    },
    "extends": ["eslint:recommended", "standard"],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "rules": {
	"camelcase": "off"
    },
    "overrides": [
        {
            "files": ["test/**/*.js"],
            "env": {
                "mocha": true,
                "node": true
            },
            "globals": {
                "Game_Interpreter": "writable",
                "PluginManager": "writable",
                "$gameMessage": "writable"
            }
        }
    ]
}
