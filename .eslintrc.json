{
    "env": {
        "browser": true,
        "commonjs": true,
        "es6": true
    },
    "extends": ["eslint:recommended", "standard"],
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "rules": {
	"camelcase": "off"
    },
    "overrides": [
        {
            "files": ["t2f-mcp.js", "t2f-help.js"],
            "rules": {
                "no-console": ["error", { "allow": ["error", "warn"] }]
            }
        },
        {
            "files": ["test/**/*.js"],
            "env": {
                "mocha": true,
                "node": true
            },
            "globals": {
                "Game_Interpreter": "writable",
                "PluginManager": "writable",
                "$gameMessage": "writable"
            }
        }
    ]
}
